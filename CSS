/* ============================================
   MARIA BILLIG BEAUTY — identidade visual
   Branco quente + dourado + rosa bebê clarinho
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');

:root{
  --white:        #FFFDFB;
  --blush:        #FBEAEC;
  --blush-deep:   #F3D3D8;
  --gold:         #B8935A;
  --gold-deep:    #8C6B3F;
  --gold-soft:    #D8BE8F;
  --ink:          #2B2420;
  --ink-soft:     #6B5F58;
  --line:         #E9DCD2;

  --serif: 'Cormorant Garamond', serif;
  --sans:  'Jost', sans-serif;

  --container: 1180px;
}

*{ box-sizing: border-box; margin:0; padding:0; }

html{ scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior: auto; }
  *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
}

body{
  font-family: var(--sans);
  color: var(--ink);
  background: var(--white);
  line-height: 1.6;
  font-weight: 300;
  overflow-x: hidden;
}

img{ max-width: 100%; display:block; }

a{ color: inherit; text-decoration: none; }

.wrap{
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 32px;
}

.eyebrow{
  font-family: var(--sans);
  font-size: 12px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold-deep);
  font-weight: 500;
}

h1,h2,h3{
  font-family: var(--serif);
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.01em;
}

h2{
  font-size: clamp(32px, 4.2vw, 48px);
  font-weight: 400;
}

.section-head{
  text-align: center;
  max-width: 640px;
  margin: 0 auto 56px;
}
.section-head .eyebrow{ display:block; margin-bottom: 14px; }
.section-head p{
  color: var(--ink-soft);
  margin-top: 14px;
  font-size: 16px;
}

section{ padding: 110px 0; position: relative; }

/* ---------- ornamento assinatura: arco dourado ---------- */
.arch-frame{
  position: relative;
  border: 1px solid var(--gold);
  border-radius: 50% 50% 4px 4px / 60% 60% 4px 4px;
  padding: 14px;
  display: inline-block;
}
.arch-frame::before{
  content:'';
  position:absolute;
  inset: -10px;
  border: 1px solid var(--gold-soft);
  border-radius: 50% 50% 4px 4px / 60% 60% 4px 4px;
  pointer-events: none;
}
.arch-frame img{
  border-radius: 50% 50% 4px 4px / 60% 60% 4px 4px;
  display:block;
  width: 100%;
  height: auto;
}

.divider-oval{
  width: 34px;
  height: 22px;
  margin: 0 auto 22px;
  border: 1.5px solid var(--gold);
  border-radius: 50%;
}

/* ---------- header ---------- */
header{
  position: fixed;
  top:0; left:0; right:0;
  z-index: 100;
  background: rgba(255,253,251,0.86);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid transparent;
  transition: border-color .3s ease, box-shadow .3s ease;
}
header.scrolled{
  border-bottom: 1px solid var(--line);
  box-shadow: 0 4px 24px rgba(184,147,90,0.06);
}
.nav{
  display:flex;
  align-items:center;
  justify-content: space-between;
  height: 84px;
}
.logo{
  font-family: var(--serif);
  font-size: 22px;
  letter-spacing: 0.03em;
  color: var(--ink);
}
.logo span{ color: var(--gold); }

.nav-links{
  display:flex;
  gap: 34px;
  list-style: none;
}
.nav-links a{
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-soft);
  transition: color .25s ease;
  position: relative;
}
.nav-links a:hover{ color: var(--gold-deep); }

.btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-family: var(--sans);
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 14px 28px;
  border-radius: 999px;
  border: 1px solid var(--gold);
  color: var(--ink);
  background: transparent;
  cursor: pointer;
  transition: background .3s ease, color .3s ease, box-shadow .3s ease, transform .2s ease;
}
.btn:hover{
  background: var(--gold);
  color: var(--white);
  box-shadow: 0 8px 22px rgba(184,147,90,0.3);
  transform: translateY(-1px);
}
.btn-solid{
  background: var(--gold);
  color: var(--white);
}
.btn-solid:hover{
  background: var(--gold-deep);
  border-color: var(--gold-deep);
}
.nav .btn{ padding: 10px 22px; font-size: 12px; }

.nav-toggle{ display:none; background:none; border:none; cursor:pointer; }
.nav-toggle span{
  display:block; width: 24px; height: 1px; background: var(--ink); margin: 6px 0;
}

/* ---------- hero ---------- */
.hero{
  padding-top: 170px;
  padding-bottom: 90px;
  background:
    radial-gradient(ellipse at 82% 12%, var(--blush) 0%, transparent 55%),
    radial-gradient(ellipse at 10% 90%, var(--blush) 0%, transparent 45%);
}
.hero .wrap{
  display:grid;
  grid-template-columns: 1.05fr 0.85fr;
  gap: 64px;
  align-items:center;
}
.hero-text .eyebrow{ margin-bottom: 20px; opacity:0; animation: fadeUp .8s ease .1s forwards; }
.hero-text h1{
  font-size: clamp(40px, 5.6vw, 68px);
  line-height: 1.08;
  font-weight: 400;
  opacity:0; animation: fadeUp .8s ease .25s forwards;
}
.hero-text h1 em{
  font-style: italic;
  color: var(--gold-deep);
}
.hero-text p{
  margin-top: 22px;
  font-size: 17px;
  color: var(--ink-soft);
  max-width: 460px;
  opacity:0; animation: fadeUp .8s ease .4s forwards;
}
.hero-cta{
  margin-top: 34px;
  display:flex;
  gap: 16px;
  flex-wrap: wrap;
  opacity:0; animation: fadeUp .8s ease .55s forwards;
}
.hero-meta{
  margin-top: 46px;
  display:flex;
  gap: 40px;
  opacity:0; animation: fadeUp .8s ease .7s forwards;
}
.hero-meta div small{
  display:block;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin-bottom: 4px;
}
.hero-meta div strong{
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 500;
  color: var(--gold-deep);
}

.hero-portrait{
  position: relative;
  opacity:0; animation: fadeIn 1.1s ease .3s forwards;
  justify-self: center;
}
.hero-portrait .arch-frame{ width: min(360px, 100%); }
.hero-portrait .pendant-note{
  position:absolute;
  bottom: -18px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--white);
  border: 1px solid var(--line);
  padding: 10px 20px;
  border-radius: 999px;
  font-size: 12px;
  letter-spacing: 0.06em;
  color: var(--ink-soft);
  white-space: nowrap;
  box-shadow: 0 10px 30px rgba(43,36,32,0.06);
}
.hero-portrait .pendant-note strong{ color: var(--gold-deep); font-weight: 500; }

@keyframes fadeUp{ from{ opacity:0; transform: translateY(16px);} to{ opacity:1; transform:none; } }
@keyframes fadeIn{ from{ opacity:0; transform: scale(.97);} to{ opacity:1; transform:none; } }

/* ---------- marquee de valores ---------- */
.marquee{
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 18px 0;
  overflow: hidden;
  background: var(--white);
}
.marquee-track{
  display:flex;
  width: max-content;
  animation: scroll 28s linear infinite;
}
.marquee-track span{
  font-family: var(--serif);
  font-style: italic;
  font-size: 18px;
  color: var(--ink-soft);
  padding: 0 34px;
  white-space: nowrap;
}
.marquee-track span::after{
  content: '✦';
  font-style: normal;
  color: var(--gold);
  margin-left: 34px;
  font-size: 12px;
}
@keyframes scroll{
  from{ transform: translateX(0); }
  to{ transform: translateX(-50%); }
}

/* ---------- services ---------- */
.services{ background: var(--white); }
.service-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.service-card{
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 40px 30px;
  background: linear-gradient(180deg, #fff 0%, #fffdfc 100%);
  transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
  position: relative;
  overflow: hidden;
}
.service-card:hover{
  transform: translateY(-6px);
  box-shadow: 0 22px 44px rgba(184,147,90,0.14);
  border-color: var(--gold-soft);
}
.service-card .icon{
  width: 46px; height: 46px;
  margin-bottom: 22px;
  color: var(--gold);
}
.service-card h3{
  font-size: 23px;
  font-weight: 500;
  margin-bottom: 10px;
}
.service-card p{
  font-size: 14.5px;
  color: var(--ink-soft);
  margin-bottom: 18px;
}
.service-card .tag{
  display:inline-block;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--gold-deep);
  border: 1px solid var(--blush-deep);
  background: var(--blush);
  padding: 5px 12px;
  border-radius: 999px;
}
.service-card.featured{
  background: linear-gradient(160deg, var(--blush) 0%, #fff 60%);
  border-color: var(--blush-deep);
}

/* ---------- processo ---------- */
.process{
  background: linear-gradient(180deg, var(--blush) 0%, var(--white) 100%);
}
.process-grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  position: relative;
}
.process-grid::before{
  content:'';
  position:absolute;
  top: 20px;
  left: 10%;
  right: 10%;
  height: 1px;
  background: repeating-linear-gradient(90deg, var(--gold) 0 6px, transparent 6px 12px);
  opacity: .6;
}
.process-step{
  text-align:center;
  padding: 0 18px;
  position: relative;
}
.process-step .num{
  width: 40px; height: 40px;
  border-radius: 50%;
  border: 1px solid var(--gold);
  background: var(--white);
  display:flex; align-items:center; justify-content:center;
  font-family: var(--serif);
  color: var(--gold-deep);
  margin: 0 auto 20px;
  position: relative;
  z-index: 2;
}
.process-step h3{ font-size: 19px; margin-bottom: 8px; }
.process-step p{ font-size: 13.5px; color: var(--ink-soft); }

/* ---------- sobre ---------- */
.about .wrap{
  display:grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 64px;
  align-items:center;
}
.about-img{ justify-self: center; }
.about-img .arch-frame{ width: min(320px, 100%); }
.about-content .eyebrow{ margin-bottom: 16px; }
.about-content h2{ margin-bottom: 20px; }
.about-content p{ color: var(--ink-soft); margin-bottom: 16px; font-size: 16px; }
.about-signature{
  margin-top: 26px;
  font-family: var(--serif);
  font-style: italic;
  font-size: 22px;
  color: var(--gold-deep);
}

/* ---------- depoimentos ---------- */
.testimonials{ background: var(--white); }
.testi-grid{
  display:grid;
  grid-template-columns: repeat(3,1fr);
  gap: 26px;
}
.testi-card{
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 32px 28px;
  background: var(--white);
}
.testi-card .stars{ color: var(--gold); font-size: 14px; letter-spacing: 2px; margin-bottom: 14px; }
.testi-card p{ font-size: 15px; color: var(--ink-soft); font-style: italic; margin-bottom: 18px; }
.testi-card .who{ font-size: 13px; letter-spacing: 0.05em; color: var(--ink); text-transform: uppercase; }

/* ---------- agendamento ---------- */
.booking{
  background: linear-gradient(180deg, var(--white) 0%, var(--blush) 100%);
}
.booking-panel{
  display:grid;
  grid-template-columns: 0.9fr 1.1fr;
  border: 1px solid var(--blush-deep);
  border-radius: 24px;
  overflow: hidden;
  background: var(--white);
  box-shadow: 0 30px 60px rgba(184,147,90,0.12);
}
.booking-info{
  background: linear-gradient(165deg, var(--ink) 0%, #3d332c 100%);
  color: var(--white);
  padding: 52px 44px;
  position: relative;
}
.booking-info .eyebrow{ color: var(--gold-soft); margin-bottom: 18px; }
.booking-info h2{ color: var(--white); font-size: clamp(28px,3vw,36px); margin-bottom: 18px; }
.booking-info p{ color: #e5dcd3; font-size: 15px; margin-bottom: 30px; }
.booking-info ul{ list-style:none; }
.booking-info li{
  display:flex; gap: 12px; align-items:flex-start;
  font-size: 14px; color: #e5dcd3;
  margin-bottom: 16px;
}
.booking-info li .dot{
  width: 6px; height:6px; border-radius:50%;
  background: var(--gold-soft); margin-top: 7px; flex-shrink:0;
}
.booking-info .whats-direct{
  margin-top: 34px;
  display:inline-flex;
  align-items:center;
  gap: 10px;
  font-size: 13px;
  letter-spacing: 0.05em;
  color: var(--gold-soft);
  border-top: 1px solid rgba(255,255,255,0.15);
  padding-top: 22px;
  width: 100%;
}

.booking-form{ padding: 52px 44px; }
.booking-form h3{ font-size: 24px; margin-bottom: 6px; }
.booking-form > p{ color: var(--ink-soft); font-size: 14px; margin-bottom: 28px; }

.field{ margin-bottom: 20px; }
.field label{
  display:block;
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin-bottom: 8px;
}
.field input, .field select, .field textarea{
  width: 100%;
  font-family: var(--sans);
  font-size: 15px;
  color: var(--ink);
  padding: 13px 16px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #fffefd;
  transition: border-color .25s ease, box-shadow .25s ease;
}
.field input:focus, .field select:focus, .field textarea:focus{
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(184,147,90,0.14);
}
.field-row{ display:grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field textarea{ resize: vertical; min-height: 80px; }

.booking-form .btn{ width: 100%; justify-content:center; margin-top: 6px; padding: 16px; font-size: 13px; }
.form-note{
  margin-top: 14px;
  font-size: 12px;
  color: var(--ink-soft);
  text-align:center;
}

/* ---------- FAQ ---------- */
.faq{ background: var(--white); }
.faq-list{ max-width: 760px; margin: 0 auto; }
.faq-item{
  border-bottom: 1px solid var(--line);
}
.faq-q{
  display:flex;
  align-items:center;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 4px;
  cursor:pointer;
  font-family: var(--serif);
  font-size: 19px;
}
.faq-q .plus{
  font-family: var(--sans);
  font-size: 20px;
  color: var(--gold);
  transition: transform .3s ease;
  flex-shrink:0;
}
.faq-item.open .faq-q .plus{ transform: rotate(45deg); }
.faq-a{
  max-height: 0;
  overflow:hidden;
  transition: max-height .35s ease;
}
.faq-a p{
  padding: 0 4px 24px;
  color: var(--ink-soft);
  font-size: 15px;
  max-width: 640px;
}

/* ---------- footer ---------- */
footer{
  background: var(--ink);
  color: #d9cfc6;
  padding: 70px 0 30px;
}
.footer-grid{
  display:grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 44px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.footer-logo{
  font-family: var(--serif);
  font-size: 24px;
  color: var(--white);
  margin-bottom: 14px;
}
.footer-logo span{ color: var(--gold-soft); }
.footer-grid p{ font-size: 14px; color: #b8ada3; max-width: 300px; }
.footer-col h4{
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold-soft);
  margin-bottom: 16px;
  font-weight: 500;
}
.footer-col ul{ list-style:none; }
.footer-col li{ margin-bottom: 10px; font-size: 14px; }
.footer-col a:hover{ color: var(--gold-soft); }
.footer-bottom{
  padding-top: 26px;
  display:flex;
  justify-content: space-between;
  font-size: 12.5px;
  color: #8f8579;
  flex-wrap: wrap;
  gap: 10px;
}

/* ---------- whatsapp float ---------- */
.whats-float{
  position: fixed;
  bottom: 26px;
  right: 26px;
  z-index: 90;
  width: 58px; height: 58px;
  border-radius: 50%;
  background: var(--gold);
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 12px 30px rgba(184,147,90,0.4);
  transition: transform .25s ease, background .25s ease;
}
.whats-float:hover{ transform: scale(1.08); background: var(--gold-deep); }
.whats-float svg{ width: 26px; height:26px; }

/* ---------- reveal on scroll ----------
   Por padrão o conteúdo é visível (garante que apareça mesmo se o
   JS não carregar). O JS adiciona ".pending" antes de observar,
   e troca por ".in" quando o elemento entra na tela. */
.reveal.pending{ opacity:0; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease; }
.reveal.pending.in{ opacity:1; transform:none; }

/* ============ responsive ============ */
@media (max-width: 980px){
  .hero .wrap{ grid-template-columns: 1fr; text-align:center; }
  .hero-text p{ margin-left:auto; margin-right:auto; }
  .hero-meta{ justify-content:center; }
  .hero-portrait{ order:-1; }
  .service-grid{ grid-template-columns: repeat(2,1fr); }
  .process-grid{ grid-template-columns: repeat(2,1fr); row-gap: 46px; }
  .process-grid::before{ display:none; }
  .about .wrap{ grid-template-columns:1fr; text-align:center; }
  .about-content p{ margin-left:auto; margin-right:auto; max-width: 520px; }
  .testi-grid{ grid-template-columns: 1fr 1fr; }
  .booking-panel{ grid-template-columns: 1fr; }
  .footer-grid{ grid-template-columns: 1fr; }
}

@media (max-width: 720px){
  .nav-links, .nav .btn{ display:none; }
  .nav-toggle{ display:block; }
  .nav-links.mobile-open{
    display:flex;
    position:absolute;
    top: 84px; left:0; right:0;
    background: var(--white);
    flex-direction:column;
    padding: 24px 32px;
    border-bottom: 1px solid var(--line);
    gap: 20px;
  }
  section{ padding: 76px 0; }
  .service-grid{ grid-template-columns: 1fr; }
  .process-grid{ grid-template-columns: 1fr; }
  .testi-grid{ grid-template-columns: 1fr; }
  .field-row{ grid-template-columns: 1fr; }
  .booking-info, .booking-form{ padding: 38px 26px; }
}
